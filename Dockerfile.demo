# A real, self-contained Temporal + Redis demo for a free web-service instance.
# Ephemeral hosting is intentional here. Use compose.yaml for persistent data.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM debian:bookworm-slim AS temporal-download
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /download
RUN curl -fL --retry 3 https://github.com/temporalio/cli/releases/download/v1.10.1/temporal_cli_1.10.1_linux_amd64.tar.gz -o temporal.tar.gz \
    && echo '4c1500e2ce2d4de136e5fe8852d9b7f82eb62f19b6b383b3e0c040519a9d20b1  temporal.tar.gz' | sha256sum -c - \
    && tar -xzf temporal.tar.gz

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends redis-server ca-certificates tini && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production PORT=3000 REDIS_URL=redis://127.0.0.1:6379 TEMPORAL_ADDRESS=127.0.0.1:7233 GOMEMLIMIT=170MiB GOGC=50
WORKDIR /app
COPY --from=temporal-download /download/temporal /usr/local/bin/temporal
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node public ./public
COPY --chown=node:node package.json ./
COPY --chown=node:node deploy/demo-entrypoint.sh ./deploy/demo-entrypoint.sh
RUN chmod +x ./deploy/demo-entrypoint.sh
USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/deploy/demo-entrypoint.sh"]
